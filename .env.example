# Aether CBT Environment
PORT=3000
DATABASE_URL=data/cbt_aether.db
ENV=development

# --- Tenant ---
# Di production, request tanpa X-Tenant-ID/X-Tenant-Slug/subdomain tenant ditolak 400.
# Untuk server satu sekolah (diakses via IP LAN/localhost), isi tenant default di server:
DEFAULT_TENANT_ID=
# Alternatif di frontend (build-time, web/.env): VITE_TENANT_ID=1, atau per-browser
# localStorage.setItem('aether_tenant_id', '1').

# WAJIB. Isi dengan hasil: openssl rand -hex 32
# Minimal 32 karakter di production; nilai default/lemah yang dikenal ditolak saat start.
JWT_SECRET=

# Password admin pertama (username "admin"), hanya dipakai bila belum ada akun admin.
# Minimal 8 karakter di production. Kosongkan setelah admin dibuat.
SETUP_ADMIN_PASSWORD=

# CORS allow-list (WAJIB di production: tanpa ini server berhenti saat start).
# Pisahkan dengan koma. Contoh: https://app.sekolah.id,https://admin.sekolah.id
CORS_ALLOWED_ORIGINS=

# Folder migrasi SQL di disk. Kosong = migrasi yang di-embed di binary (disarankan).
# Migrasi tercatat di tabel schema_migrations dan hanya dijalankan sekali.
MIGRATIONS_DIR=

# --- Database connection pool (SQLite WAL, skala ~500 siswa konkuren) ---
# WAL mengizinkan banyak pembaca paralel + satu penulis; penulisan hasil sudah
# diserialkan oleh worker queue, jadi pool moderat aman untuk pembacaan paralel.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=30

# --- Unggah paket soal iSpring ---
# Batas ukuran ZIP (byte). Default 100 MB.
SOAL_UPLOAD_MAX_BYTES=104857600
# Batas jumlah berkas per paket (anti zip-bomb).
SOAL_PACKAGE_MAX_FILES=5000

# --- Anti-cheat ---
# Ambang jumlah pelanggaran (mis. pindah tab) sebelum sesi dikunci server-side.
ANTICHEAT_LOCK_THRESHOLD=3

# --- Penyajian konten ---
# Flag Secure untuk cookie sesi konten (aether_exam).
# "auto" = aktif otomatis di HTTPS/production; set "true"/"false" untuk override.
CONTENT_COOKIE_SECURE=auto

# --- Submission queue (filesystem) ---
QUEUE_DIR=data/queue
QUEUE_MAX_RETRIES=5
QUEUE_STUCK_THRESHOLD_MIN=5
# When "true", every in-flight job is re-enqueued on startup regardless of age.
# Default false (safer): only jobs stuck longer than QUEUE_STUCK_THRESHOLD_MIN are promoted.
QUEUE_RECOVER_FORCE_ALL=false
QUEUE_DONE_RETENTION_DAYS=7
QUEUE_BATCH_SIZE=5
QUEUE_BATCH_TIMEOUT_MS=100

# --- Rate Limiter ---
# Batas percobaan login per menit per akun + IP + tenant (P1-8, H3). Default 10.
# Karena dihitung per akun, siswa satu lab di balik 1 IP NAT tidak saling memblokir.
AUTH_RATE_LIMIT_PER_MIN=10
# Batas kedua per tenant + IP (semua akun) untuk membatasi password spraying.
# Default 10x AUTH_RATE_LIMIT_PER_MIN; naikkan bila satu IP NAT melayani lab sangat besar.
AUTH_IP_RATE_LIMIT_PER_MIN=100

# CSV IP/CIDR reverse proxy tepercaya (mis. 10.0.0.0/8 untuk Coolify/Traefik).
# Bila diisi, IP klien diambil dari X-Forwarded-For. Kosongkan bila tanpa proxy.
TRUSTED_PROXIES=

# --- Webhook ---
# Batas rate webhook iSpring per menit per attempt token (P1-10). Default 1000.
WEBHOOK_RATE_LIMIT_PER_MIN=1000
